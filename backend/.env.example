# Copia este archivo como .env y completa los valores reales.

# PostgreSQL: postgresql+psycopg2://usuario:contrasena@host:puerto/basededatos
DATABASE_URL=postgresql+psycopg2://postgres:TU_PASSWORD@localhost:5432/fashionstore

# Clave para firmar los JWT (usa una cadena larga y aleatoria en producción)
SECRET_KEY=cambia_esta_clave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos para CORS (separados por comas).
# En desarrollo: los de Angular local. En producción: añade el dominio del frontend
# desplegado, p. ej.  https://fashionstore.tudominio.com
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# URL del frontend (para armar el enlace del correo de recuperación).
# En producción debe ser la URL pública del frontend desplegado (https://...).
FRONTEND_URL=http://localhost:4200

# ─── Vestidor virtual (CU32) ───
# IMPORTANTE: si FASHN_API_KEY está vacío, el CU32 NO usa IA generativa: cae al
# motor local de amoldado anatómico (segmentación + pose + remapeo geométrico).
# Ese motor coloca y entalla la prenda correctamente, pero no inventa pliegues
# ni sombras de tejido. Para resultado fotorrealista hay que poner la clave.
# FASHN_MODEL_NAME=tryon-max (calidad) o tryon-v1.6 (menor costo/latencia).
FASHN_API_KEY=
FASHN_MODEL_NAME=tryon-max
FASHN_POLL_TIMEOUT_SEC=95
# Segmentación de la PERSONA (u2net_human_seg reconoce cuerpos).
REMBG_MODEL_NAME=u2net_human_seg
# Segmentación de la PRENDA: modelo de propósito general, capaz de recortar una
# blusa blanca sobre fondo blanco y de descartar sofá, percha o marca de agua.
GARMENT_REMBG_MODEL=isnet-general-use
# Ángulo brazo-torso (grados) a partir del cual la manga se reproyecta sobre el
# brazo. Por debajo viaja con el remapeo del torso, que es lo correcto cuando el
# brazo cae en reposo (que es como sale la manga en la foto de producto).
SLEEVE_REPROJECTION_MIN_DEG=35
PERSON_MASK_CONFIDENCE_THRESHOLD=0.75
POSE_LANDMARKER_MODEL_PATH=models/pose_landmarker_lite.task
POSE_DETECTION_CONFIDENCE=0.70
POSE_PRESENCE_CONFIDENCE=0.70
POSE_LANDMARK_CONFIDENCE_THRESHOLD=0.75

# IDM-VTON solo se intenta si existe un endpoint compatible configurado por el proyecto.
HUGGINGFACE_API_TOKEN=

# Correo saliente (CU03). Con Gmail: activa la verificación en 2 pasos y crea
# una "Contraseña de aplicaciones" (16 letras, sin espacios) para SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=
SMTP_FROM=tucorreo@gmail.com
SMTP_FROM_NAME=FashionStore

# ─── Pasarela de pago PayPal (CU18/CU19/CU26) ───
# 1) Entra a https://developer.paypal.com con tu cuenta PayPal → Apps & Credentials
#    (pestaña "Sandbox") → Create App → copia el Client ID y el Secret aquí.
# 2) En Testing Tools → Sandbox Accounts está la cuenta "Personal" (comprador) con
#    la que se inicia sesión en la ventana de PayPal para pagar (dinero ficticio).
# Si se dejan vacías, la tienda funciona en MODO SIMULACIÓN (no se contacta a PayPal).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_EXCHANGE_RATE_BOB_USD=6.96
